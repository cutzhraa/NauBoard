<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Style Tombol Huruf Biasa -->
    <style name="NauKeyStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginLeft">3dp</item>
        <item name="android:layout_marginRight">3dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Style Tombol Khusus (Shift, Delete, Return) -->
    <style name="NauSpecialKeyStyle" parent="NauKeyStyle">
        <item name="android:background">#ACB4C2</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>